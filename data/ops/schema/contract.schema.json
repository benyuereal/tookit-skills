{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gitlab.hygon.cn/tsoc/kits-platform/dcu-toolkit-skills/data/ops/schema/contract.schema.json",
  "title": "DCU 算子契约（contract.yaml）",
  "description": "算子卡的机器可读契约。算子卡内 contract.yaml 的结构约束；scripts/opverify.py 按此判定一次 run 是否通过。写法说明见 Plugins/ops/skills/op-contract/SKILL.md。",
  "type": "object",
  "required": ["op", "shapes", "dtypes", "tolerance", "invariants", "gates", "floor"],
  "additionalProperties": true,
  "properties": {
    "op": {
      "type": "string",
      "description": "算子名，与目录名去 op- 前缀后一致",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": { "type": "integer", "minimum": 1 },
    "math": {
      "type": "string",
      "description": "一行数学定义；必须写明哨兵值语义（-1 无效索引、-inf 死区等）"
    },
    "shapes": {
      "type": "object",
      "description": "符号维度，不放具体数值（具体数值在 shapes/ 档位文件里）",
      "additionalProperties": {
        "type": "array",
        "items": { "oneOf": [{ "type": "string" }, { "type": "integer" }] }
      }
    },
    "dtypes": {
      "type": "object",
      "description": "输入/累加/输出 dtype；acc 必填",
      "required": ["acc"],
      "additionalProperties": { "type": "string" }
    },
    "layout_constraints": {
      "type": "array",
      "description": "会导致结论反转的布局事实；跨布局的性能数据不可比较",
      "items": { "type": "string" }
    },
    "tolerance": {
      "type": "object",
      "required": ["vs_fp32_ref", "variant_vs_variant"],
      "properties": {
        "vs_fp32_ref": {
          "type": "object",
          "required": ["max_abs", "cosine"],
          "properties": {
            "max_abs": { "type": "number", "minimum": 0 },
            "cosine": { "type": "number", "minimum": 0, "maximum": 1 },
            "note": { "type": "string" }
          }
        },
        "variant_vs_variant": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["bit_exact", "tolerance"] },
            "max_abs": { "type": "number" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "description": "结构正确性判据；determinism 为必备项",
      "items": {
        "type": "object",
        "required": ["name", "mode"],
        "properties": {
          "name": {
            "enum": [
              "determinism",
              "padding_invariance",
              "index_permutation_invariance",
              "batch_independence",
              "split_invariance",
              "shape_tiling_invariance",
              "layout_invariance",
              "expert_permutation_invariance"
            ]
          },
          "mode": { "enum": ["bit_exact", "tolerance"] },
          "repeats": { "type": "integer", "minimum": 2 },
          "note": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "enum": ["correctness", "invariants", "perf"] },
          "script": { "type": "string", "description": "相对算子卡目录的脚本路径" },
          "required": { "type": "boolean", "default": true },
          "skip_reason": { "type": "string", "description": "required=false 时必填" },
          "require": { "type": "string", "description": "如 median_ms <= baseline_ms * 1.02" },
          "repeats": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "floor": {
      "type": "object",
      "required": ["metric", "peak", "unit", "basis", "at_floor_threshold"],
      "properties": {
        "metric": { "enum": ["hbm_bandwidth", "tflops", "latency"] },
        "peak": { "type": "number", "description": "物理常数（硬件峰值），不是实测值" },
        "unit": { "type": "string" },
        "basis": { "type": "string", "description": "必须能被人用计算器复算" },
        "source": { "type": "string" },
        "status": { "enum": ["verified", "unverified"] },
        "at_floor_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.85 }
      }
    }
  }
}
