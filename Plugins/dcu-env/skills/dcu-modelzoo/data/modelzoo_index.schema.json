{
  "$id": "modelzoo_index.schema.json",
  "description": "env/dcu-modelzoo 快照 data/modelzoo_index.json 的结构约束；6（fetch_modelzoo.py 落盘后自校验）",
  "type": "object",
  "required": ["fetched_at", "source", "total", "projects"],
  "properties": {
    "fetched_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "total": { "type": "integer", "minimum": 1 },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "path_with_namespace", "name", "default_branch", "last_activity"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "path_with_namespace": { "type": "string", "pattern": "^[^/]+/.+" },
          "name": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "default_branch": { "type": "string", "minLength": 1 },
          "web_url": { "type": ["string", "null"] },
          "last_activity": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "star_count": { "type": ["integer", "null"] },
          "props": { "type": "object" },
          "props_error": { "type": "string" },
          "readme_hints": {
            "type": "object",
            "required": ["dtks", "images", "cards", "readme_error"],
            "properties": {
              "dtks": { "type": "array", "items": { "type": "string" } },
              "images": { "type": "array", "items": { "type": "string" } },
              "cards": { "type": "array", "items": { "type": "string" } },
              "readme_error": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
