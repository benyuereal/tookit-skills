{
  "$id": "sourcefind_dcu_images.schema.json",
  "description": "env/dcu-image-hub 镜像快照 data/sourcefind_dcu_images.json 的结构约束；由 scripts/fetch_sourcefind_images.py 落盘后自校验，也可用包根 scripts/json_schema_mini.py 手查",
  "type": "object",
  "required": ["fetched_at", "source", "images"],
  "properties": {
    "fetched_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "uuid", "name", "repo", "project", "accelerator", "updated", "tags"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "uuid": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "accelerator": { "type": "string", "minLength": 1 },
          "abstract": { "type": "string" },
          "pull_count": { "type": ["integer", "null"] },
          "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "detail_url": { "type": "string" },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "push_time"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "size": { "type": ["string", "null"] },
                "pull_url": { "type": ["string", "null"] },
                "push_time": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "release_type": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
