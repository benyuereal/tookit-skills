{
  "$id": "upstream-snapshot.schema.json",
  "description": "HYGON-AI upstream snapshot (references/hygon-upstream/upstream-snapshot.json) written by scripts/hygon-upstream-sync.py",
  "type": "object",
  "required": [
    "fetched_at",
    "org",
    "repos",
    "anchors",
    "cookbook_matrix"
  ],
  "properties": {
    "fetched_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "org": {
      "type": "string",
      "minLength": 1
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "desc",
          "lang",
          "stars",
          "pushed_at",
          "archived"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string"
          },
          "lang": {
            "type": [
              "string",
              "null"
            ]
          },
          "stars": {
            "type": "integer",
            "minimum": 0
          },
          "pushed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "archived": {
            "type": "boolean"
          }
        }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor": {
          "type": "string"
        }
      }
    },
    "cookbook_matrix": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "ok",
          "wip",
          "-"
        ]
      }
    }
  }
}